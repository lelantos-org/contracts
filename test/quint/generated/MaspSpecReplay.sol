    }

    /// A pick the action declares must have been drawn. Absence means the spec
    /// and the config disagree about the action's shape, which would otherwise
    /// surface as the driver silently using a zero.
    function _requirePicks(MaspSpec.Action a, MaspSpec.Picks memory p) private pure {
        if (a == MaspSpec.Action.Submit) {
            require(p.hasPublicIn, "masp: action `submit` did not draw nondet pick `publicIn`");
        } else if (a == MaspSpec.Action.Flush) {
            require(p.hasId, "masp: action `flush` did not draw nondet pick `id`");
        } else if (a == MaspSpec.Action.Cancel) {
            require(p.hasId, "masp: action `cancel` did not draw nondet pick `id`");
        } else if (a == MaspSpec.Action.CancelTooEarly) {
            require(p.hasId, "masp: action `cancelTooEarly` did not draw nondet pick `id`");
        } else if (a == MaspSpec.Action.AdvanceBlocks) {
            require(p.hasN, "masp: action `advanceBlocks` did not draw nondet pick `n`");
        } else if (a == MaspSpec.Action.SetCancelDelay) {
            require(p.hasNewDelay, "masp: action `setCancelDelay` did not draw nondet pick `newDelay`");
        } else if (a == MaspSpec.Action.SetAssetDisabled) {
            require(p.hasDisabled, "masp: action `setAssetDisabled` did not draw nondet pick `disabled`");
        }
