        n += _eqU(string.concat(f, ".length"), m.length, c.length);
        // Lengths differing makes element-wise output noise, not signal.
        if (m.length != c.length) return n;
        for (uint256 i = 0; i < m.length; i++) {
            n += _cmpDepositEntry(string.concat(f, "[", vm.toString(i), "]"), m[i], c[i]);
        }
    }

    function _cmpDepositEntry(string memory f, MaspSpec.DepositEntry memory m, MaspSpec.DepositEntry memory c)
        private
        returns (uint256 n)
    {
        n += _eqU(string.concat(f, ".key"), m.key, c.key);
        n += _eqU(string.concat(f, ".principal"), m.principal, c.principal);
        n += _eqU(string.concat(f, ".fee"), m.fee, c.fee);
        n += _eqU(string.concat(f, ".submittedAt"), m.submittedAt, c.submittedAt);
        n += _eqStr(string.concat(f, ".status"), MaspSpec.statusName(m.status), MaspSpec.statusName(c.status));
    }
}
