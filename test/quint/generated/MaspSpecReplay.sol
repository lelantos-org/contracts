    /// Compare every state variable, accumulating rather than short-circuiting,
    /// so one step reports every field that moved.
    function _assertState(MaspSpec.State memory model_, MaspSpec.State memory chain, string memory action) private {
        _mismatches += _eqU("blockNo", model_.blockNo, chain.blockNo);
        _mismatches += _eqU("nextId", model_.nextId, chain.nextId);
        _mismatches += _cmpArrMaspSpec_DepositEntry("deposits", model_.deposits, chain.deposits);
        _mismatches += _eqU("poolBalance", model_.poolBalance, chain.poolBalance);
        _mismatches += _eqU("accruedFee", model_.accruedFee, chain.accruedFee);
        _mismatches += _eqU("treasuryBalance", model_.treasuryBalance, chain.treasuryBalance);
        _mismatches += _eqU("payerBalance", model_.payerBalance, chain.payerBalance);
        _mismatches += _eqU("committedCount", model_.committedCount, chain.committedCount);
        _mismatches += _eqU("cancelDelay", model_.cancelDelay, chain.cancelDelay);
        _mismatches += _eqB("assetDisabled", model_.assetDisabled, chain.assetDisabled);
